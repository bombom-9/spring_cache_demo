<?xml version="1.0" encoding="UTF-8"?>
<infinispan
    xmlns="urn:infinispan:config:14.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="urn:infinispan:config:14.0 https://infinispan.org/schemas/infinispan-config-14.0.xsd">

    <cache-container name="demo">
        <transport stack="udp">
            <property name="configurationFile">udp.xml</property>
        </transport>

        <serialization marshaller="org.infinispan.commons.marshall.JavaSerializationMarshaller">
            <!-- <context-initializer  /> -->
            <allow-list>
                <regex>com.demo.*</regex>
            </allow-list>
        </serialization>

        <distributed-cache name="testCache" mode="SYNC">
            <encoding media-type="application/x-java-serialized-object" />
            <expiration lifespan="300000" interval="60000" />
            <persistence passivation="false">
                <file-store path="${java.io.tmpdir}" preload="true">
                    <write-behind modification-queue-size="5" />
                </file-store>
            </persistence>
            <memory storage="HEAP" max-size="5MB" when-full="REMOVE" />
        </distributed-cache>

    </cache-container>

</infinispan>